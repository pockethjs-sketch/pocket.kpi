{
  "name": "pocket-kpi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8765",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8765",
    "check": "npm run build && node scripts/verify-build.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "node --test tests/*.test.mjs",
    "test:supabase": "node --test tests/*.test.mjs",
    "migrate:supabase:dry-run": "node scripts/migrate-sheets-to-supabase.mjs"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "vite": "8.2.2"
  }
}
